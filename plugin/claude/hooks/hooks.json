{
  "description": "Checks that relative links in an edited kb/ page point at files that exist.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check_kb_links.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
